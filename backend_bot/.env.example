# Copie para .env (nesta pasta) e preencha. O .env nunca vai para o git.
# Tudo é opcional para desenvolvimento: os padrões apontam para o LiveKit local.

# --- Discord ---------------------------------------------------------------
# Developer Portal -> sua aplicação -> Bot -> Reset Token. Vazio: sobe só a API.
DISCORD_TOKEN=
# Clique direito no servidor -> Copiar ID (precisa do modo desenvolvedor).
# Com ele os comandos aparecem na hora; sem ele, o registro global leva até 1 h.
DISCORD_GUILD_ID=
# Nome ou ID do cargo que pode usar /transmitir. Vazio: qualquer membro.
CARGO_TRANSMISSOR=

# --- LiveKit (mesmo par do infra_sfu/.env) ------------------------------------
# URL que o cliente desktop e os espectadores usam para conectar.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_local_apenas_para_testes_0123456789

# --- API -------------------------------------------------------------------
# Endereço público do backend: é a base dos links /assistir/<chave> que o bot posta.
URL_PUBLICA=http://127.0.0.1:8000
# Em produção atrás do Caddy, mantenha 127.0.0.1 (o Caddy faz o TLS na 443).
HOST=127.0.0.1
PORTA=8000
BANCO=dados/backend.sqlite3
