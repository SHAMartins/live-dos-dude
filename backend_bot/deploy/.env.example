# Copie para .env (nesta pasta, na VM do backend) e preencha. chmod 600 .env

# --- Domínio -----------------------------------------------------------------
API_DOMAIN=api.seudominio.com
# Base dos links /assistir/<chave> que o bot posta.
URL_PUBLICA=https://api.seudominio.com

# --- Discord ------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_GUILD_ID=
CARGO_TRANSMISSOR=

# --- LiveKit (o mesmo par do infra_sfu/.env da outra VM) -----------------------
LIVEKIT_URL=wss://live.seudominio.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
