# Copie para .env e preencha. O .env nunca vai para o git.

# Subdomínio apontado (registro A) para o IP público reservado da VM.
LIVEKIT_DOMAIN=live.seudominio.com

# Gere com:  docker run --rm livekit/livekit-server:v1.13.9 generate-keys
# O backend vai usar exatamente o mesmo par para assinar os tokens.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
